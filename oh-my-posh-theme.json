{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#FDE725",
          "foreground": "#272822",
          "leading_diamond": "",
          "powerline_symbol": "",
          "style": "diamond",
          "template": "  {{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "#90D743",
          "foreground": "#272822",
          "powerline_symbol": "",
          "properties": {
            "style": "folder"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#35B779",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FD971F{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#F92672{{ end }}",
            "{{ if gt .Ahead 0 }}#31688E{{ end }}",
            "{{ if gt .Behind 0 }}#FD971F{{ end }}"
          ],
          "foreground": "#272822",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#F8F8F2{{ end }}",
            "{{ if gt .Ahead 0 }}#F8F8F2{{ end }}"
          ],
          "powerline_symbol": "",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#F8F8F2",
          "background": "#21918C",
          "template": "  {{ .Full }} "
        },
        {
          "background": "#31688E",
          "background_templates": [
            "{{ if gt .Code 0 }}#F92672{{ end }}"
          ],
          "foreground": "#F8F8F2",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#F8F8F2{{ end }}"
          ],
          "leading_diamond": "<transparent,background></>",
          "properties": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": "  ",
          "trailing_diamond": "",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "background": "#443983",
          "foreground": "#F8F8F2",
          "leading_diamond": "",
          "powerline_symbol": "",
          "style": "diamond",
          "template": "  {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#440154",
          "foreground": "#F8F8F2",
          "leading_diamond": "<transparent,background></>",
          "properties": {
            "time_format": "15:04:05"
          },
          "style": "diamond",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 3
}
