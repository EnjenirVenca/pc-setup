{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "bg": "#2D2A2E",
    "fg": "#FCFCFA",
    "dimmed": "#727072",
    "surface": "#5B595C",
    "red": "#FC4675",
    "orange": "#FC9867",
    "yellow": "#FED154",
    "green": "#A9DC76",
    "cyan": "#78DCE8",
    "purple": "#AB9DF2"
  },
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "",
          "powerline_symbol": "",
          "background": "p:yellow",
          "foreground": "p:bg",
          "template": "  {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:green",
          "foreground": "p:bg",
          "options": {
            "style": "folder"
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:cyan",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:orange{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:purple{{ end }}",
            "{{ if gt .Behind 0 }}p:orange{{ end }}"
          ],
          "foreground": "p:bg",
          "options": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:purple",
          "foreground": "p:bg",
          "template": "  {{ .Full }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "<transparent,background></>",
          "trailing_diamond": "",
          "background": "p:dimmed",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "foreground": "p:fg",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:bg{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "  "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "shell",
          "style": "diamond",
          "leading_diamond": "",
          "powerline_symbol": "",
          "background": "p:surface",
          "foreground": "p:fg",
          "template": "  {{ .Name }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "<transparent,background></>",
          "trailing_diamond": "",
          "background": "p:dimmed",
          "foreground": "p:fg",
          "options": {
            "time_format": "15:04:05"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    }
  ]
}
